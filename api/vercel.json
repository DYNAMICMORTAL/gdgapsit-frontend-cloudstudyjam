{
  "functions": {
    "uploadCertificate.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "verify.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "certificate/*.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-ADMIN-KEY, Content-Type, Authorization"
        }
      ]
    }
  ]
}
