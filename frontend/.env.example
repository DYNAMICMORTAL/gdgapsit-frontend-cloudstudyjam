## Frontend Environment Variables
# Copy this file to `.env` inside `frontend/` and fill in the real values.

# Public Supabase project URL.
VITE_SUPABASE_URL=your_supabase_url_here

# Supabase anon key (safe for browser usage).
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# URL where the backend certificate API will be deployed (Vercel/Supabase Edge/etc.).
VITE_BACKEND_URL=http://localhost:3000

# Base site URL used inside QR codes and verification links.
VITE_SITE_URL=https://your-domain.com
